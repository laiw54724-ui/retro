diff --git a/apps/web/src/lib/useMobileViewport.ts b/apps/web/src/lib/useMobileViewport.ts
new file mode 100644
index 0000000000000000000000000000000000000000..96ce59169fb33eb1c51bd66b73a094cd25811c0f
--- /dev/null
+++ b/apps/web/src/lib/useMobileViewport.ts
@@ -0,0 +1,11 @@
+import { useSyncExternalStore } from "react";
+const query = "(max-width: 767px)";
+const subscribe = (notify: () => void) => {
+  const media = globalThis.matchMedia(query);
+  media.addEventListener("change", notify);
+  return () => media.removeEventListener("change", notify);
+};
+const snapshot = () => globalThis.matchMedia(query).matches;
+export function useMobileViewport(): boolean {
+  return useSyncExternalStore(subscribe, snapshot, () => false);
+}
