{
  "name": "retrodesk",
  "private": true,
  "packageManager": "pnpm@10.18.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @retrodesk/web --filter @retrodesk/api dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:e2e": "playwright test",
    "icons:install": "node scripts/install-windows-icons.mjs",
    "icons:remove": "node scripts/install-windows-icons.mjs --remove",
    "icons:import": "node scripts/import-windows-icons.mjs",
    "icons:audit": "node scripts/import-windows-icons.mjs --check",
    "assets:audit": "node scripts/audit-third-party-assets.mjs",
    "assets:audit:release": "node scripts/audit-third-party-assets.mjs --release",
    "licenses:audit": "node scripts/audit-dependency-licenses.mjs",
    "licenses:report": "node scripts/audit-dependency-licenses.mjs --write",
    "security:audit": "node scripts/audit-secrets.mjs",
    "verify:contributor": "pnpm security:audit && pnpm assets:audit:release && pnpm licenses:audit && pnpm typecheck && pnpm test:unit && pnpm build && pnpm security:audit -- --artifacts-only && pnpm test:e2e",
    "test:e2e:i18n-preview": "VITE_I18N_PREVIEW_LOCALES=true playwright test tests/e2e/i18n.spec.ts tests/e2e/i18n-coverage.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.50.0"
  }
}
